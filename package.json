{
  "name": "haunted-chocolatier-twilight",
  "version": "0.1.6",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "preview": "vite preview --host 127.0.0.1",
    "build": "tsc --noEmit && vite build && node tools/build-offline.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:browser": "node tools/browser-tests.mjs test",
    "install:browsers": "node tools/browser-tests.mjs install chromium webkit",
    "check:spec": "node tools/check-spec.mjs",
    "check": "pnpm check:spec && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "dexie": "^4.4.6",
    "jsqr": "^1.4.0",
    "phaser": "3.90.0",
    "qrcode": "^1.5.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.6.1",
    "@types/qrcode": "^1.5.6",
    "eslint": "^10.10.0",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
